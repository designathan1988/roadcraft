{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/scripts/gate.mjs", "touch"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/gate.mjs", "stop"],
            "timeout": 900,
            "statusMessage": "npm run check (scripts/gate.mjs)"
          }
        ]
      }
    ]
  }
}
