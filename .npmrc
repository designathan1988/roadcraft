# Do not auto-install peer dependencies.
#
# `clipper2-js` is published by ng-packagr and therefore declares Angular as a
# peer dependency, but the module itself is self-contained: its fesm2015 bundle
# has ZERO imports, verified rather than assumed. Letting npm satisfy that peer
# pulls @angular/core and @angular/common into a project with no framework, and
# with them three high-severity advisories that have nothing to do with polygon
# clipping.
#
# With this set, `npm install` reports 0 vulnerabilities and the tree stays at
# 48 packages. Without it, Angular reappears on the next clean install in CI.
legacy-peer-deps=true
