{
  "name": "roadcraft",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "Roadcraft — a 3D isometric road-building and traffic-simulation game for the browser",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5300 --strictPort",
    "dev:planet": "vite --mode planet --host 127.0.0.1 --port 5300 --strictPort",
    "dev:planet:old-unit": "vite --mode planet-old-unit --host 127.0.0.1 --port 5300 --strictPort",
    "build": "node scripts/run-limited.mjs npm run build:raw",
    "build:raw": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-limited.mjs npm run test:raw",
    "test:raw": "vitest run",
    "test:watch": "node scripts/run-limited.mjs npm run test:watch:raw",
    "test:watch:raw": "vitest",
    "test:coverage": "node scripts/run-limited.mjs npm run test:coverage:raw",
    "test:coverage:raw": "vitest run --coverage",
    "check": "node scripts/run-limited.mjs npm run check:raw",
    "check:raw": "npm run lint && npm run typecheck && node scripts/knip-check.mjs && npm run test:raw && npm run test:planet:raw && npm run test:scale:raw && npm run build:raw",
    "setup": "git config core.hooksPath .githooks",
    "cook:people": "node scripts/cook-people.mjs --base=http://127.0.0.1:5300",
    "desktop": "electron desktop/main.cjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test:planet:raw": "vitest run -c vitest.planet.config.ts",
    "test:planet": "node scripts/run-limited.mjs npm run test:planet:raw",
    "test:scale:raw": "vitest run -c vitest.scale.config.ts",
    "test:scale": "node scripts/run-limited.mjs npm run test:scale:raw",
    "gate": "node scripts/run-limited.mjs --kill-gb=1.2 --min-free-gb=4 node scripts/gate/gate.mjs",
    "build:modos": "node scripts/run-limited.mjs node scripts/build-modes.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.6.0",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "knip": "6.38.0",
    "meshoptimizer": "1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-18",
    "earcut": "^3.2.3",
    "jolt-physics": "^1.1.0",
    "polygon-clipping": "0.15.7",
    "three": "^0.186.0"
  }
}
