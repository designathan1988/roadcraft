{
  "name": "roadcraft",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "description": "Roadcraft — a 3D isometric road-building and traffic-simulation game for the browser",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5300 --strictPort",
    "build": "node scripts/run-limited.mjs npm run build:raw",
    "build:raw": "tsc --noEmit && vite build && vite build -c scripts/vite/desktop-jobs.config.ts",
    "build:probe": "vite build --mode probe --outDir dist-probe",
    "preview:probe": "vite preview --outDir dist-probe --host 127.0.0.1 --port 5301 --strictPort",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "typecheck:tsc": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --suppressions-location scripts/baselines/eslint-suppressions.json",
    "test": "node scripts/run-limited.mjs npm run test:raw",
    "test:raw": "vitest run",
    "test:watch": "node scripts/run-limited.mjs npm run test:watch:raw",
    "test:watch:raw": "vitest",
    "test:coverage": "node scripts/run-limited.mjs npm run test:coverage:raw",
    "test:coverage:raw": "vitest run --coverage",
    "check": "node scripts/run-limited.mjs node scripts/check.mjs",
    "check:all": "node scripts/run-limited.mjs node scripts/check.mjs --all",
    "cook:people": "node scripts/cook-people.mjs --base=http://127.0.0.1:5300",
    "cook:cities": "node scripts/cook-cities.mjs",
    "desktop": "electron desktop/main.cjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test:scale:raw": "vitest run -c vitest.scale.config.ts",
    "test:scale": "node scripts/run-limited.mjs npm run test:scale:raw",
    "budgets": "node scripts/run-limited.mjs npm run budgets:raw",
    "budgets:raw": "vitest run -c vitest.scale.config.ts tests/perf/budgets.spec.ts",
    "postinstall": "patch-package --patch-dir scripts/patches"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.6.0",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "knip": "6.38.0",
    "meshoptimizer": "1.2.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-18",
    "earcut": "^3.2.3",
    "jolt-physics": "^1.1.0",
    "polygon-clipping": "0.15.7",
    "three": "^0.186.0"
  },
  "knip": {
    "entry": [
      "index.html",
      "src/main.ts!",
      "src/sim/sim.worker.ts!",
      "src/jobs/job.worker.ts!",
      "src/render/bake/catalogue.ts!",
      "scripts/**/*.mjs",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/saves.cjs",
      "desktop/jobs.cjs",
      "src/jobs/nodeJobHost.ts!",
      "scripts/vite/desktop-jobs.config.ts",
      "eslint-rules/*.js"
    ],
    "project": [
      "src/**/*.ts!",
      "tests/**/*.ts",
      "scripts/**/*.mjs",
      "eslint-rules/*.js",
      "*.ts",
      "desktop/*.cjs",
      "scripts/**/*.ts"
    ],
    "ignoreDependencies": [
      "electron",
      "steamworks.js"
    ],
    "ignoreBinaries": [
      "taskkill.exe"
    ]
  }
}
