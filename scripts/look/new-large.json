{
  "viewport": [1280, 720],
  "dialogs": "accept",
  "steps": [
    { "usageStart": { "every": 250 } },
    { "until": "performance.getEntriesByName('opening:shown').length > 0", "name": "boot map shown", "timeout": 180000, "polling": 250 },
    { "eval": "performance.clearMarks()" },
    { "press": "Menu" }, { "wait": 500 },
    { "press": "Nova metrópole (cidade grande)" }, { "wait": 800 },
    { "until": "performance.getEntriesByName('city:applied').length > 0 && performance.getEntriesByName('opening:shown').length > 0", "name": "metropolis shown", "timeout": 300000, "polling": 250 },
    { "shot": "opening-district" },
    { "eval": "performance.getEntriesByType('mark').filter(m => /^(city:|world:|frame:)/.test(m.name)).map(m => ({ name: m.name, at: Math.round(m.startTime) }))" },
    { "usageEnd": true },
    { "setView": [0, 0, 0.6, 0, 89] }, { "wait": 6000 },
    { "shot": "map-top" }, { "memory": "exact" }, { "record": "map-frames" }, { "wait": 2500 }, { "recordEnd": true },
    { "setView": [0, 0, 2.5, 0, 89] }, { "wait": 6000 },
    { "shot": "district-top" },
    { "lookAt": [0, 0, 0.35] }, { "wait": 8000 },
    { "shot": "map" }, { "memory": "exact" },
    { "lookAt": [0, 0, 2.5] }, { "wait": 6000 },
    { "shot": "district" }, { "memory": "exact" },
    { "lookAt": [600, 0, 2.5] }, { "wait": 4000 },
    { "shot": "district-east" },
    { "lookAt": [-600, 0, 2.5] }, { "wait": 4000 },
    { "shot": "district-west" },
    { "lookAt": [0, 600, 2.5] }, { "wait": 4000 },
    { "shot": "district-north" },
    { "lookAt": [0, -600, 2.5] }, { "wait": 4000 },
    { "shot": "district-south" },
    { "lookAt": [900, 900, 3.5] }, { "wait": 4000 },
    { "shot": "neighbourhood" },
    { "lookAt": [1500, 0, 1.5] }, { "wait": 4000 },
    { "shot": "city-edge-far" },
    { "setView": [150, 0, 5, 20, 35] }, { "wait": 5000 },
    { "shot": "street-1-angle" }, { "memory": "exact" }, { "record": "street-frames" }, { "wait": 2500 }, { "recordEnd": true },
    { "shot": "street-detail", "clip": [320, 180, 640, 360] },
    { "setView": [-150, 0, 5, 110, 35] }, { "wait": 4000 },
    { "shot": "street-2-angle" },
    { "setView": [150, 180, 5, 200, 35] }, { "wait": 4000 },
    { "shot": "street-3-angle" },
    { "setView": [-150, -180, 5, 290, 35] }, { "wait": 4000 },
    { "shot": "street-4-angle" },
    { "setView": [150, 0, 7, 20, 30] }, { "wait": 4000 },
    { "shot": "street-close" },
    { "setView": [150, 0, 4, 20, 20] }, { "wait": 4000 },
    { "shot": "street-low" },
    { "setView": [150, 0, 4, 20, 60] }, { "wait": 4000 },
    { "shot": "street-high" }
  ]
}
