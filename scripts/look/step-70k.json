{
  "storage": {
    "roadcraft.quality": "ultra"
  },
  "viewport": [
    1920,
    1080
  ],
  "steps": [
    {
      "eval": "performance.clearMarks(); window.__roadcraft.generateCity({ seed: 7, size: 'large', radiusMetres: 4700 }); 'started'"
    },
    {
      "until": "performance.getEntriesByName('city:applied').length > 0 && performance.getEntriesByName('opening:shown').length > 0",
      "name": "city shown",
      "timeout": 1800000,
      "polling": 500
    },
    {
      "until": "(() => { const c = document.getElementById('loading-curtain'); return !!c && getComputedStyle(c).display === 'none'; })()",
      "name": "curtain gone",
      "timeout": 600000,
      "polling": 500
    },
    {
      "press": "Começar a construir"
    },
    {
      "wait": 3000
    },
    {
      "eval": "window.__roadcraft.sim.setClock(720); window.__roadcraft.scene().setSkyMode('day'); window.__roadcraft.measure(true); 1"
    },
    {
      "setView": [
        0,
        0,
        0.075,
        45,
        48
      ]
    },
    {
      "wait": 8000
    },
    {
      "shot": "map"
    },
    {
      "memory": "exact"
    },
    {
      "setView": [
        0,
        0,
        2.5,
        45,
        48
      ]
    },
    {
      "wait": 8000
    },
    {
      "shot": "district"
    },
    {
      "memory": "exact"
    },
    {
      "setView": [
        150,
        0,
        5,
        20,
        35
      ]
    },
    {
      "wait": 8000
    },
    {
      "shot": "street"
    },
    {
      "memory": "exact"
    }
  ]
}
